{
  "name": "medieval-incremental",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Dark-Medieval Incremental Game – Die Asche von Vhal",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts",
    "verify": "npm run check && npm run lint && npm run test && npm run build",
    "e2e": "playwright test",
    "tauri:dev": "npx --yes @tauri-apps/cli@2 dev",
    "tauri:build": "npx --yes @tauri-apps/cli@2 build",
    "cloud-server": "tsx server/main.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "break_infinity.js": "^2.2.0",
    "inkjs": "^2.3.2",
    "lz-string": "^1.5.0",
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
