{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Die Asche von Vhal",
  "version": "0.1.0",
  "identifier": "io.github.malvonius.vhal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Die Asche von Vhal", "width": 1280, "height": 860, "minWidth": 380 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
